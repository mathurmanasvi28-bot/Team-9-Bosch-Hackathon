TARGET_COMPOSE_PROJECT=opentelemetry-demo
TARGET_REPOSITORY_PATH=../opentelemetry-demo

STORE_URL=http://localhost:8080
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686

MAX_FAULT_DURATION_SECONDS=60
MAX_NETWORK_DELAY_MS=1000
MAX_PACKET_LOSS_PERCENT=40

# Root of the otel-demo checkout (contains src/ and compose.yaml); rank_agent's source search is sandboxed to it
OTEL_DEMO_SRC=C:/path/to/opentelemetry-demo
LLM_API_KEY=